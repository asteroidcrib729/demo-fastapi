# Runtime: pooled PostgreSQL URL for the project's ONE production database.
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
# Setup only: direct URL for that SAME database. Do not add it to Render.
